<Window x:Class="AccentIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Accent It"
        Height="700"
        Width="980"
        MinHeight="600"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="DiagnosticLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,9,0,3" />
        </Style>

        <Style x:Key="DiagnosticValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MarkToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="MarkBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MarkBorder" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MarkBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="MarkBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MarkBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MarkBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="SecondaryBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="SecondaryBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecondaryBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="OutputModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OutputModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OutputModeBorder" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OutputModeBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="OutputModeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OutputModeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OutputModeBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTabRadioStyle"
               TargetType="RadioButton"
               BasedOn="{StaticResource OutputModeRadioStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Accent It"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Button x:Name="ThemeToggleButton"
                        Content="深夜模式"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,7"
                        Click="ThemeToggleButton_Click"
                        ToolTip="切换界面配色"
                        AutomationProperties.Name="切换到深夜模式"
                        AutomationProperties.AutomationId="ThemeToggleButton" />
                <Button x:Name="QuickInputButton"
                        Content="紧凑窗口 (F2)"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="12,7"
                        Margin="8,0,0,0"
                        Click="QuickInputButton_Click"
                        ToolTip="切换到紧凑窗口"
                        AutomationProperties.Name="切换到紧凑窗口"
                        AutomationProperties.AutomationId="QuickInputButton" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="18,13"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="基础字母"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,4" />
                    <TextBox x:Name="BaseLetterBox"
                             Width="88"
                             Height="44"
                             FontSize="24"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="4,0"
                             Background="{DynamicResource FieldBrush}"
                             BorderBrush="{DynamicResource LineBrush}"
                             TextChanged="BaseLetterBox_TextChanged"
                             ToolTip="输入单个字母"
                             AutomationProperties.AutomationId="BaseLetterBox" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="InputHintTextBlock"
                               Text=""
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock x:Name="ConfigStatusTextBlock"
                               Text="正在读取符号目录…"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="HotkeyStatusTextBlock"
                                   Text="全局快捷键：读取中…"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="HotkeyStatusTextBlock" />

                        <Button x:Name="OpenSettingsButton"
                                Grid.Column="1"
                                Content="设置"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,3"
                                FontSize="11"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Click="OpenSettingsButton_Click"
                                ToolTip="修改后重启程序生效"
                                AutomationProperties.AutomationId="OpenSettingsButton" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <RadioButton x:Name="MarksTabRadio"
                                     Content="组合符号"
                                     GroupName="EditorSection"
                                     IsChecked="True"
                                     Style="{StaticResource EditorTabRadioStyle}"
                                     Checked="EditorTab_Checked"
                                     AutomationProperties.AutomationId="MarksTab" />
                        <RadioButton x:Name="OperationsTabRadio"
                                     Content="字母变形"
                                     GroupName="EditorSection"
                                     Style="{StaticResource EditorTabRadioStyle}"
                                     Checked="EditorTab_Checked"
                                     AutomationProperties.AutomationId="OperationsTab" />
                        <RadioButton x:Name="OtherLettersTabRadio"
                                     Content="其他字符"
                                     GroupName="EditorSection"
                                     Style="{StaticResource EditorTabRadioStyle}"
                                     Checked="EditorTab_Checked"
                                     AutomationProperties.AutomationId="OtherLettersTab" />
                    </StackPanel>

                    <Grid>
                        <ScrollViewer x:Name="MarkGroupsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel x:Name="MarkGroupsPanel" />
                        </ScrollViewer>

                        <ScrollViewer x:Name="OperationGroupsScrollViewer"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <StackPanel x:Name="OperationGroupsPanel" />
                        </ScrollViewer>

                        <Grid x:Name="OtherLettersGrid"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBox x:Name="OtherLetterSearchBox"
                                         Height="32"
                                         Padding="8,4"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource FieldBrush}"
                                         BorderBrush="{DynamicResource LineBrush}"
                                         TextChanged="OtherLetterSearchBox_TextChanged"
                                         AutomationProperties.Name="搜索其他字符"
                                         AutomationProperties.AutomationId="OtherLetterSearchBox" />
                                <TextBlock x:Name="OtherLetterSearchHintTextBlock"
                                           Text="搜索字母、名称或码点"
                                           Margin="9,0,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          Margin="0,8,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <StackPanel>
                                    <TextBlock x:Name="OtherLetterCountTextBlock"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="OtherLetterCountTextBlock" />
                                    <StackPanel x:Name="OtherLetterGroupsPanel" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="预览"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="输出"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <RadioButton x:Name="NfcOutputRadio"
                                             Content="NFC"
                                             GroupName="OutputNormalization"
                                             IsChecked="True"
                                             Style="{StaticResource OutputModeRadioStyle}"
                                             Checked="OutputModeRadio_Checked"
                                             Margin="0,0,4,0"
                                             AutomationProperties.Name="NFC 输出"
                                             AutomationProperties.AutomationId="OutputNfcRadio"
                                             ToolTip="NFC 输出（默认）：优先使用预组合字符；无法完整预组合时保留 NFC 序列。" />
                                <RadioButton x:Name="NfdOutputRadio"
                                             Content="NFD"
                                             GroupName="OutputNormalization"
                                             Style="{StaticResource OutputModeRadioStyle}"
                                             Checked="OutputModeRadio_Checked"
                                             AutomationProperties.Name="NFD 输出"
                                             AutomationProperties.AutomationId="OutputNfdRadio"
                                             ToolTip="NFD 输出：完全分解为基础字母与组合符号；此模式不应用例外规则。" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource PreviewBrush}"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,10">
                            <TextBlock x:Name="PreviewTextBlock"
                                       Text="—"
                                       FontFamily="Cambria Math"
                                       FontSize="72"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MinHeight="96"
                                       TextOptions.TextFormattingMode="Ideal"
                                       AutomationProperties.AutomationId="PreviewTextBlock" />
                        </Border>

                        <TextBlock x:Name="OutputKindTextBlock"
                                   Text="等待输入"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="OutputKindTextBlock" />
                        <TextBlock x:Name="OutputCodePointsTextBlock"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="OutputCodePointsTextBlock" />

                        <TextBlock x:Name="PathStatusTextBlock"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   AutomationProperties.AutomationId="PathStatusTextBlock" />

                        <Separator Margin="0,14,0,14" Background="{DynamicResource LineBrush}" />

                        <TextBlock x:Name="SelectedOperationsHeaderTextBlock"
                                   Text="已选变形"
                                   Style="{StaticResource SectionTitleStyle}"
                                   FontSize="13"
                                   Visibility="Collapsed" />
                        <WrapPanel x:Name="SelectedOperationsPanel"
                                   Visibility="Collapsed" />

                        <StackPanel x:Name="SecondLetterPanel"
                                    Visibility="Collapsed"
                                    Margin="0,4,0,8">
                            <TextBlock Text="合字的第二个字母"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="SecondLetterBox"
                                     Width="88"
                                     Height="36"
                                     FontSize="20"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="4,0"
                                     Background="{DynamicResource FieldBrush}"
                                     BorderBrush="{DynamicResource LineBrush}"
                                     TextChanged="SecondLetterBox_TextChanged"
                                     ToolTip="输入单个字母"
                                     AutomationProperties.Name="合字的第二个字母"
                                     AutomationProperties.AutomationId="SecondLetterBox" />
                        </StackPanel>

                        <TextBlock x:Name="SelectedHeaderTextBlock"
                                   Text="已选符号"
                                   Style="{StaticResource SectionTitleStyle}"
                                   FontSize="13" />
                        <WrapPanel x:Name="SelectedMarksPanel" MinHeight="28" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="UndoButton"
                                    Content="撤销"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UndoButton_Click"
                                    IsEnabled="False"
                                    ToolTip="撤销最后一个变形、第二个字母或符号" />
                            <Button x:Name="ClearButton"
                                    Content="清空"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ClearButton_Click"
                                    IsEnabled="False"
                                    Margin="8,0,0,0"
                                    ToolTip="清空所有变形、第二个字母和符号" />
                        </StackPanel>

                        <Button x:Name="CopyButton"
                                Content="复制结果"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CopyButton_Click"
                                Margin="0,14,0,0"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="CopyButton" />

                        <Expander x:Name="DiagnosticsExpander"
                                  Header="诊断详情"
                                  Margin="0,16,0,0"
                                  Foreground="{DynamicResource InkBrush}"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.AutomationId="DiagnosticsExpander">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="配置来源" Style="{StaticResource DiagnosticLabelStyle}" />
                                <TextBlock x:Name="ConfigPathTextBlock"
                                           Style="{StaticResource DiagnosticValueStyle}"
                                           Text="—" />

                                <TextBlock Text="设置文件" Style="{StaticResource DiagnosticLabelStyle}" />
                                <TextBlock x:Name="SettingsPathTextBlock"
                                           Style="{StaticResource DiagnosticValueStyle}"
                                           Text="—" />

                                <TextBlock Text="原始序列" Style="{StaticResource DiagnosticLabelStyle}" />
                                <TextBlock x:Name="RawTextBlock"
                                           Style="{StaticResource DiagnosticValueStyle}"
                                           Text="—" />

                                <TextBlock Text="NFC" Style="{StaticResource DiagnosticLabelStyle}" />
                                <TextBlock x:Name="NfcTextBlock"
                                           Style="{StaticResource DiagnosticValueStyle}"
                                           Text="—" />

                                <TextBlock Text="NFD" Style="{StaticResource DiagnosticLabelStyle}" />
                                <TextBlock x:Name="NfdTextBlock"
                                           Style="{StaticResource DiagnosticValueStyle}"
                                           Text="—" />

                                <TextBlock x:Name="AppliedRuleTextBlock"
                                           Style="{StaticResource DiagnosticValueStyle}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,9,0,0"
                                           Visibility="Collapsed" />

                                <TextBlock Text="配置问题"
                                           Style="{StaticResource DiagnosticLabelStyle}"
                                           Margin="0,12,0,3" />
                                <TextBlock x:Name="IssuesTextBlock"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="没有配置问题。" />

                                <TextBlock Text="设置问题"
                                           Style="{StaticResource DiagnosticLabelStyle}"
                                           Margin="0,12,0,3" />
                                <TextBlock x:Name="SettingsIssuesTextBlock"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="没有设置问题。" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   Margin="2,11,0,0"
                   FontSize="11"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Text=""
                   AutomationProperties.AutomationId="StatusTextBlock" />
    </Grid>
</Window>
