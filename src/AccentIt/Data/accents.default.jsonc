{
  "schemaVersion": 1,

  // 位置分组的显示顺序由数组顺序决定。
  "positions": [
    { "id": "above", "displayName": "上方" },
    { "id": "below", "displayName": "下方" },
    { "id": "overlay", "displayName": "叠加" }
  ],

  // 符号的显示顺序由数组顺序决定。
  // codePoint 必须使用 U+XXXX 形式，避免源码中出现不可见的组合字符。
  // id 只能包含 ASCII 字母、数字、-、_、.，并且不能重复。
  "marks": [
    { "id": "grave", "codePoint": "U+0300", "name": "重音符", "position": "above" },
    { "id": "acute", "codePoint": "U+0301", "name": "锐音符", "position": "above" },
    { "id": "circumflex", "codePoint": "U+0302", "name": "抑扬符", "position": "above" },
    { "id": "tilde", "codePoint": "U+0303", "name": "波浪符", "position": "above" },
    { "id": "macron", "codePoint": "U+0304", "name": "长音符", "position": "above" },
    { "id": "breve", "codePoint": "U+0306", "name": "短音符", "position": "above" },
    { "id": "dot-above", "codePoint": "U+0307", "name": "上点符", "position": "above" },
    { "id": "diaeresis", "codePoint": "U+0308", "name": "分音符", "position": "above" },
    { "id": "ring-above", "codePoint": "U+030A", "name": "上圆环", "position": "above" },
    { "id": "double-acute", "codePoint": "U+030B", "name": "双锐音符", "position": "above" },
    { "id": "caron", "codePoint": "U+030C", "name": "倒折符", "position": "above" },
    { "id": "double-grave", "codePoint": "U+030F", "name": "双重音符", "position": "above" },
    { "id": "inverted-breve", "codePoint": "U+0311", "name": "倒置短音符", "position": "above" },
    { "id": "horn", "codePoint": "U+031B", "name": "角符", "position": "above" },

    { "id": "dot-below", "codePoint": "U+0323", "name": "下点符", "position": "below" },
    { "id": "ring-below", "codePoint": "U+0325", "name": "下圆环", "position": "below" },
    { "id": "comma-below", "codePoint": "U+0326", "name": "下逗号", "position": "below" },
    { "id": "cedilla", "codePoint": "U+0327", "name": "软音符", "position": "below" },
    { "id": "ogonek", "codePoint": "U+0328", "name": "反尾形符", "position": "below" },
    { "id": "circumflex-below", "codePoint": "U+032D", "name": "下抑扬符", "position": "below" },
    { "id": "breve-below", "codePoint": "U+032E", "name": "下短音符", "position": "below" },
    { "id": "tilde-below", "codePoint": "U+0330", "name": "下波浪符", "position": "below" },
    { "id": "macron-below", "codePoint": "U+0331", "name": "下长音符", "position": "below" },

    { "id": "overlay-tilde", "codePoint": "U+0334", "name": "波浪覆盖", "position": "overlay" },
    { "id": "overlay-short-stroke", "codePoint": "U+0335", "name": "短横覆盖", "position": "overlay" },
    { "id": "overlay-long-stroke", "codePoint": "U+0336", "name": "长横覆盖", "position": "overlay" },
    { "id": "overlay-short-slash", "codePoint": "U+0337", "name": "短斜线覆盖", "position": "overlay" },
    { "id": "overlay-long-slash", "codePoint": "U+0338", "name": "长斜线覆盖", "position": "overlay" }
  ],

  "composition": {
    // "nfc"：默认。始终输出 NFC 规范化结果。完整预组合时得到单个字符，
    //        否则得到 NFC 序列，可能出现“部分预组合”。
    // "nfd"：完全分解为基础字母 + 已选符号，不使用预组合字符，
    //        也不应用下面的例外规则。
    "mode": "nfc",

    // 例外映射：基础字母 + 一组符号 id（顺序无关）→ 单个预组合字母。
    // 规则优先于 "nfc"；使用 "nfd" 时不应用规则。示例：
    // {
    //   "base": "o",
    //   "marks": ["overlay-long-slash"],
    //   "resultCodePoint": "U+00F8",
    //   "note": "o + 长斜线 → ø；这是显式映射，不是 NFC 自动结果"
    // }
    "rules": []
  },

  // 字母路径与“其他字符”数据。需要调整时直接修改本文件；
  // 程序不再生成或读取单独的 accents.jsonc。
  "letterComposition": {
    // 四个 Unicode 区块。范围包含非字母字符，统计时按 Unicode 字母类别过滤。
    "blocks": [
      {
        "id": "latin-1-supplement",
        "displayName": "Latin-1 增补",
        "firstCodePoint": "U+0080",
        "lastCodePoint": "U+00FF"
      },
      {
        "id": "latin-extended-a",
        "displayName": "拉丁扩展 A",
        "firstCodePoint": "U+0100",
        "lastCodePoint": "U+017F"
      },
      {
        "id": "latin-extended-b",
        "displayName": "拉丁扩展 B",
        "firstCodePoint": "U+0180",
        "lastCodePoint": "U+024F"
      },
      {
        "id": "ipa-extensions",
        "displayName": "国际音标扩展",
        "firstCodePoint": "U+0250",
        "lastCodePoint": "U+02AF"
      }
    ],

    // 抽象变形操作。操作本身没有码点，只是路径规则的一部分。
    // requiresSecondLetter = true 时，界面会要求输入第二个字母（用于合字）。
    "operations": [
      { "id": "turn", "name": "倒转", "group": "方向", "description": "旋转 180°" },
      { "id": "reverse", "name": "反向", "group": "方向", "description": "左右镜像" },
      { "id": "long-leg", "name": "长腿", "group": "笔画", "description": "延长向下的一笔" },
      { "id": "left-hook", "name": "左钩", "group": "笔画", "description": "在左侧或末端加钩" },
      { "id": "right-hook", "name": "右钩", "group": "笔画", "description": "在右侧或末端加钩" },
      { "id": "tail", "name": "加尾", "group": "笔画", "description": "加上向下或向后的小尾" },
      { "id": "small-capital", "name": "小型大写", "group": "形态", "description": "使用小型大写形态" },
      { "id": "open", "name": "开口", "group": "形态", "description": "使用开口字形" },
      { "id": "hook", "name": "加钩", "group": "笔画", "description": "在字形上加一个钩" },
      { "id": "topbar", "name": "顶横", "group": "笔画", "description": "在字母顶部加一横" },
      { "id": "curl", "name": "卷曲", "group": "笔画", "description": "在笔画末端加卷曲" },
      { "id": "ligature", "name": "合字", "group": "结构", "description": "把两个字母合成一个字符", "requiresSecondLetter": true }
    ],

    // 路径规则。marks 与 operations 二选一：
    // - marks：组合符号例外映射，只在 NFC 模式生效；
    // - operations：变形路径，NFC/NFD 都先得到结果字母，再按模式处理组合符号。
    // 同一基础字母和同一组操作/符号（顺序无关）只能有一条规则。
    // 找不到匹配规则时，程序会提示“没有这条组合路径”，不会自动猜测。
    "rules": [
      // —— 叠加符号例外 ——
      { "base": "o", "marks": ["overlay-long-slash"], "resultCodePoint": "U+00F8", "note": "o + 长斜线 → ø" },
      { "base": "O", "marks": ["overlay-long-slash"], "resultCodePoint": "U+00D8", "note": "O + 长斜线 → Ø" },
      { "base": "o", "marks": ["overlay-long-slash", "acute"], "resultCodePoint": "U+01FF", "note": "o + 长斜线 + 锐音符 → ǿ" },
      { "base": "O", "marks": ["overlay-long-slash", "acute"], "resultCodePoint": "U+01FE", "note": "O + 长斜线 + 锐音符 → Ǿ" },
      { "base": "ø", "marks": ["acute"], "resultCodePoint": "U+01FF", "note": "ø + 锐音符 → ǿ" },
      { "base": "Ø", "marks": ["acute"], "resultCodePoint": "U+01FE", "note": "Ø + 锐音符 → Ǿ" },
      { "base": "d", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0111", "note": "d + 短横覆盖 → đ" },
      { "base": "D", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0110", "note": "D + 短横覆盖 → Đ" },
      { "base": "l", "marks": ["overlay-short-slash"], "resultCodePoint": "U+0142", "note": "l + 短斜线覆盖 → ł" },
      { "base": "L", "marks": ["overlay-short-slash"], "resultCodePoint": "U+0141", "note": "L + 短斜线覆盖 → Ł" },
      { "base": "b", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0180", "note": "b + 短横覆盖 → ƀ" },
      { "base": "B", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0243", "note": "B + 短横覆盖 → Ƀ" },
      { "base": "h", "marks": ["overlay-long-stroke"], "resultCodePoint": "U+0127", "note": "h + 长横覆盖 → ħ" },
      { "base": "H", "marks": ["overlay-long-stroke"], "resultCodePoint": "U+0126", "note": "H + 长横覆盖 → Ħ" },
      { "base": "t", "marks": ["overlay-long-stroke"], "resultCodePoint": "U+0167", "note": "t + 长横覆盖 → ŧ" },
      { "base": "T", "marks": ["overlay-long-stroke"], "resultCodePoint": "U+0166", "note": "T + 长横覆盖 → Ŧ" },
      { "base": "Z", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+01B5", "note": "Z + 短横覆盖 → Ƶ" },
      { "base": "z", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+01B6", "note": "z + 短横覆盖 → ƶ" },
      { "base": "A", "marks": ["overlay-long-slash"], "resultCodePoint": "U+023A", "note": "A + 长斜线覆盖 → Ⱥ" },
      { "base": "C", "marks": ["overlay-short-slash"], "resultCodePoint": "U+023B", "note": "C + 短斜线覆盖 → Ȼ" },
      { "base": "c", "marks": ["overlay-short-slash"], "resultCodePoint": "U+023C", "note": "c + 短斜线覆盖 → ȼ" },
      { "base": "L", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+023D", "note": "L + 短横覆盖 → Ƚ" },
      { "base": "T", "marks": ["overlay-long-slash"], "resultCodePoint": "U+023E", "note": "T + 长斜线覆盖 → Ⱦ" },
      { "base": "U", "marks": ["overlay-long-stroke"], "resultCodePoint": "U+0244", "note": "U + 长横覆盖 → Ʉ" },
      { "base": "E", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0246", "note": "E + 短横覆盖 → Ɇ" },
      { "base": "e", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0247", "note": "e + 短横覆盖 → ɇ" },
      { "base": "J", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0248", "note": "J + 短横覆盖 → Ɉ" },
      { "base": "j", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0249", "note": "j + 短横覆盖 → ɉ" },
      { "base": "R", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+024C", "note": "R + 短横覆盖 → Ɍ" },
      { "base": "r", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+024D", "note": "r + 短横覆盖 → ɍ" },
      { "base": "Y", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+024E", "note": "Y + 短横覆盖 → Ɏ" },
      { "base": "y", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+024F", "note": "y + 短横覆盖 → ɏ" },
      { "base": "G", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+01E4", "note": "G + 短横覆盖 → Ǥ" },
      { "base": "g", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+01E5", "note": "g + 短横覆盖 → ǥ" },
      { "base": "I", "marks": ["overlay-long-stroke"], "resultCodePoint": "U+0197", "note": "I + 长横覆盖 → Ɨ" },
      { "base": "i", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0268", "note": "i + 短横覆盖 → ɨ" },
      { "base": "u", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0289", "note": "u + 短横覆盖 → ʉ" },
      { "base": "o", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+0275", "note": "o + 短横覆盖 → ɵ" },
      { "base": "O", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+019F", "note": "O + 短横覆盖 → Ɵ" },
      { "base": "l", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+019A", "note": "l + 短横覆盖 → ƚ" },
      { "base": "l", "marks": ["overlay-tilde"], "resultCodePoint": "U+026B", "note": "l + 波浪覆盖 → ɫ" },
      { "base": "λ", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+019B", "note": "λ + 短横覆盖 → ƛ" },
      { "base": "ʖ", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+01BE", "note": "ʖ + 短横覆盖 → ƾ" },
      { "base": "ʔ", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+02A1", "note": "ʔ + 短横覆盖 → ʡ" },
      { "base": "ʕ", "marks": ["overlay-short-stroke"], "resultCodePoint": "U+02A2", "note": "ʕ + 短横覆盖 → ʢ" },
      { "base": "Ǳ", "marks": ["caron"], "resultCodePoint": "U+01C4", "note": "Ǳ + 倒折符 → Ǆ" },
      { "base": "ǲ", "marks": ["caron"], "resultCodePoint": "U+01C5", "note": "ǲ + 倒折符 → ǅ" },
      { "base": "ǳ", "marks": ["caron"], "resultCodePoint": "U+01C6", "note": "ǳ + 倒折符 → ǆ" },
      
      // —— 钩形 ——
      // 在字母上添加钩形笔画；钩的位置由具体路径决定。
      { "base": "n", "operations": ["left-hook"], "resultCodePoint": "U+0272", "note": "n + 左钩 → ɲ" },
      { "base": "t", "operations": ["right-hook"], "resultCodePoint": "U+0288", "note": "t + 右钩 → ʈ" },
      { "base": "n", "operations": ["right-hook"], "resultCodePoint": "U+0273", "note": "n + 右钩 → ɳ" },
      { "base": "B", "operations": ["hook"], "resultCodePoint": "U+0181", "note": "B + 加钩 → Ɓ" },
      { "base": "b", "operations": ["hook"], "resultCodePoint": "U+0253", "note": "b + 加钩 → ɓ" },
      { "base": "C", "operations": ["hook"], "resultCodePoint": "U+0187", "note": "C + 加钩 → Ƈ" },
      { "base": "c", "operations": ["hook"], "resultCodePoint": "U+0188", "note": "c + 加钩 → ƈ" },
      { "base": "D", "operations": ["hook"], "resultCodePoint": "U+018A", "note": "D + 加钩 → Ɗ" },
      { "base": "d", "operations": ["hook"], "resultCodePoint": "U+0257", "note": "d + 加钩 → ɗ" },
      { "base": "F", "operations": ["hook"], "resultCodePoint": "U+0191", "note": "F + 加钩 → Ƒ" },
      { "base": "f", "operations": ["hook"], "resultCodePoint": "U+0192", "note": "f + 加钩 → ƒ" },
      { "base": "G", "operations": ["hook"], "resultCodePoint": "U+0193", "note": "G + 加钩 → Ɠ" },
      { "base": "g", "operations": ["hook"], "resultCodePoint": "U+0260", "note": "g + 加钩 → ɠ" },
      { "base": "K", "operations": ["hook"], "resultCodePoint": "U+0198", "note": "K + 加钩 → Ƙ" },
      { "base": "k", "operations": ["hook"], "resultCodePoint": "U+0199", "note": "k + 加钩 → ƙ" },
      { "base": "P", "operations": ["hook"], "resultCodePoint": "U+01A4", "note": "P + 加钩 → Ƥ" },
      { "base": "p", "operations": ["hook"], "resultCodePoint": "U+01A5", "note": "p + 加钩 → ƥ" },
      { "base": "T", "operations": ["hook"], "resultCodePoint": "U+01AC", "note": "T + 加钩 → Ƭ" },
      { "base": "t", "operations": ["hook"], "resultCodePoint": "U+01AD", "note": "t + 加钩 → ƭ" },
      { "base": "Y", "operations": ["hook"], "resultCodePoint": "U+01B3", "note": "Y + 加钩 → Ƴ" },
      { "base": "y", "operations": ["hook"], "resultCodePoint": "U+01B4", "note": "y + 加钩 → ƴ" },
      { "base": "Z", "operations": ["hook"], "resultCodePoint": "U+0224", "note": "Z + 加钩 → Ȥ" },
      { "base": "z", "operations": ["hook"], "resultCodePoint": "U+0225", "note": "z + 加钩 → ȥ" },
      { "base": "V", "operations": ["hook"], "resultCodePoint": "U+01B2", "note": "V + 加钩 → Ʋ" },
      { "base": "v", "operations": ["hook"], "resultCodePoint": "U+028B", "note": "v + 加钩 → ʋ" },
      { "base": "m", "operations": ["hook"], "resultCodePoint": "U+0271", "note": "m + 加钩 → ɱ" },
      { "base": "h", "operations": ["hook"], "resultCodePoint": "U+0266", "note": "h + 加钩 → ɦ" },
      { "base": "s", "operations": ["hook"], "resultCodePoint": "U+0282", "note": "s + 加钩 → ʂ" },
      { "base": "q", "operations": ["hook"], "resultCodePoint": "U+02A0", "note": "q + 加钩 → ʠ" },
      { "base": "ə", "operations": ["hook"], "resultCodePoint": "U+025A", "note": "ə + 加钩 → ɚ" },
      { "base": "N", "operations": ["left-hook"], "resultCodePoint": "U+019D", "note": "N + 左钩 → Ɲ" },
      { "base": "r", "operations": ["hook"], "resultCodePoint": "U+027E", "note": "r + 加钩 → ɾ" },
      { "base": "r", "operations": ["hook", "turn"], "resultCodePoint": "U+027B", "note": "r + 加钩 + 倒转 → ɻ" },
      { "base": "ɹ", "operations": ["hook"], "resultCodePoint": "U+027B", "note": "ɹ + 加钩 → ɻ" },
      { "base": "r", "operations": ["hook", "reverse"], "resultCodePoint": "U+027F", "note": "r + 加钩 + 反向 → ɿ" },
      { "base": "ɾ", "operations": ["reverse"], "resultCodePoint": "U+027F", "note": "ɾ + 反向 → ɿ" },
      { "base": "h", "operations": ["hook", "turn"], "resultCodePoint": "U+02AE", "note": "h + 加钩 + 倒转 → ʮ" },
      { "base": "h", "operations": ["hook", "tail", "turn"], "resultCodePoint": "U+02AF", "note": "h + 加钩 + 加尾 + 倒转 → ʯ" },
      { "base": "ɦ", "operations": ["tail", "turn"], "resultCodePoint": "U+02AF", "note": "ɦ + 加尾 + 倒转 → ʯ" },
      { "base": "ʮ", "operations": ["tail"], "resultCodePoint": "U+02AF", "note": "ʮ + 加尾 → ʯ" },
      { "base": "g", "operations": ["hook", "small-capital"], "resultCodePoint": "U+029B", "note": "g + 加钩 + 小型大写 → ʛ" },
      { "base": "ɢ", "operations": ["hook"], "resultCodePoint": "U+029B", "note": "ɢ + 加钩 → ʛ" },
      { "base": "T", "operations": ["right-hook"], "resultCodePoint": "U+01AE", "note": "T + 右钩 → Ʈ" },
      { "base": "z", "operations": ["right-hook"], "resultCodePoint": "U+0290", "note": "z + 右钩 → ʐ" },
      // —— 顶横 ——
      // 在字母顶部加一横。
      { "base": "B", "operations": ["topbar"], "resultCodePoint": "U+0182", "note": "B + 顶横 → Ƃ" },
      { "base": "b", "operations": ["topbar"], "resultCodePoint": "U+0183", "note": "b + 顶横 → ƃ" },
      { "base": "D", "operations": ["topbar"], "resultCodePoint": "U+018B", "note": "D + 顶横 → Ƌ" },
      { "base": "d", "operations": ["topbar"], "resultCodePoint": "U+018C", "note": "d + 顶横 → ƌ" },
      // —— 卷曲 ——
      // 在笔画末端加卷曲；合字 + 卷曲用于带卷曲的合字。
      { "base": "c", "operations": ["curl"], "resultCodePoint": "U+0255", "note": "c + 卷曲 → ɕ" },
      { "base": "d", "operations": ["curl"], "resultCodePoint": "U+0221", "note": "d + 卷曲 → ȡ" },
      { "base": "l", "operations": ["curl"], "resultCodePoint": "U+0234", "note": "l + 卷曲 → ȴ" },
      { "base": "n", "operations": ["curl"], "resultCodePoint": "U+0235", "note": "n + 卷曲 → ȵ" },
      { "base": "t", "operations": ["curl"], "resultCodePoint": "U+0236", "note": "t + 卷曲 → ȶ" },
      { "base": "ʃ", "operations": ["curl"], "resultCodePoint": "U+0286", "note": "ʃ + 卷曲 → ʆ" },
      { "base": "z", "operations": ["curl"], "resultCodePoint": "U+0291", "note": "z + 卷曲 → ʑ" },
      { "base": "ʒ", "operations": ["curl"], "resultCodePoint": "U+0293", "note": "ʒ + 卷曲 → ʓ" },
      { "base": "d", "second": "z", "operations": ["curl", "ligature"], "resultCodePoint": "U+02A5", "note": "d + z + 卷曲 + 合字 → ʥ" },
