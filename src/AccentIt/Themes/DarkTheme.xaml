<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深夜主题：冷调蓝黑底 + 天蓝强调色，避免纯黑背景过于刺眼。 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="InkBrush" Color="#E7EEF8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AAAC2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6BB6FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#18304D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#131D2E" />
    <SolidColorBrush x:Key="PreviewBrush" Color="#19263A" />
    <SolidColorBrush x:Key="LineBrush" Color="#2A3B54" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#486280" />
    <SolidColorBrush x:Key="FieldBrush" Color="#0D1625" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#071321" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#93C9FF" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#4C97E8" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8F8F" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#3A2027" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#332D18" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#D6B15B" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#3A516C" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#587593" />
</ResourceDictionary>
