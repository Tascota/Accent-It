<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 日间主题。两套主题必须定义完全相同的键，切换时整体替换。 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F3ED" />
    <SolidColorBrush x:Key="InkBrush" Color="#24211C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6E675D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B45309" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBE9D7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF9" />
    <SolidColorBrush x:Key="PreviewBrush" Color="#F1ECE3" />
    <SolidColorBrush x:Key="LineBrush" Color="#DED6C8" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#C4B8A7" />
    <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#92400E" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#78350F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FEE4E2" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#D97706" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C4B8A7" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A99B87" />
</ResourceDictionary>
