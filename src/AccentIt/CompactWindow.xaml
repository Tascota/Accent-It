<Window x:Class="AccentIt.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Accent It 快速输入"
        Width="460"
        Height="430"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Background="#F6F3ED"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="CompactWindow"
        AutomationProperties.Name="Accent It 快速输入"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#24211C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6E675D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#B45309" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBE9D7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF9" />
        <SolidColorBrush x:Key="PreviewBrush" Color="#F1ECE3" />
        <SolidColorBrush x:Key="LineBrush" Color="#DED6C8" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
        <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FEE4E2" />
        <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FEF3C7" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#D97706" />

        <!-- 紧凑窗口的符号按钮只显示“虚线圈 + 组合符号”，
             名称、码点和说明放在悬停提示里，避免占满窗口。 -->
        <Style x:Key="CompactMarkToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="MarkBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MarkBorder" Property="BorderBrush" Value="#C4B8A7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MarkBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="MarkBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MarkBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MarkBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#92400E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#78350F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="CompactModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#C4B8A7" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 目标应用 + 切换到完整编辑器。标题栏已经显示窗口名称，这里不再重复大标题。 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TargetHintTextBlock"
                       Text="正在识别目标应用…"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       AutomationProperties.AutomationId="CompactTargetHint" />

            <Button x:Name="SwitchToEditorButton"
                    Grid.Column="1"
                    Content="完整编辑器（F2）"
                    Style="{StaticResource CompactSecondaryButtonStyle}"
                    Padding="8,3"
                    FontSize="11"
                    Click="SwitchToEditorButton_Click"
                    ToolTip="切换到完整编辑器（F2）；当前输入会一起带过去。"
                    AutomationProperties.Name="切换到完整编辑器"
                    AutomationProperties.AutomationId="CompactSwitchToEditorButton" />
        </Grid>

        <Border x:Name="CatalogBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource WarningSurfaceBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="9,6"
                Margin="0,0,0,8">
            <TextBlock x:Name="CatalogBannerTextBlock"
                       FontSize="11"
                       Foreground="{StaticResource InkBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- 基础字母和输出模式放在同一行，保持紧凑。 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="字母"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <TextBox x:Name="BaseLetterBox"
                     Grid.Column="1"
                     Width="52"
                     Height="34"
                     FontSize="21"
                     TextAlignment="Center"
                     VerticalContentAlignment="Center"
                     Padding="3,0"
                     Background="White"
                     BorderBrush="{StaticResource LineBrush}"
                     TextChanged="BaseLetterBox_TextChanged"
                     ToolTip="基础字母：输入单个 Unicode 字母。"
                     AutomationProperties.Name="基础字母"
                     AutomationProperties.AutomationId="CompactBaseLetterBox" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0">
                <RadioButton x:Name="NfcOutputRadio"
                             Content="NFC"
                             GroupName="CompactOutputNormalization"
                             IsChecked="True"
                             Style="{StaticResource CompactModeRadioStyle}"
                             Checked="OutputModeRadio_Checked"
                             Margin="0,0,4,0"
                             AutomationProperties.Name="NFC 输出"
                             AutomationProperties.AutomationId="CompactNfcRadio"
                             ToolTip="NFC 输出（默认）：优先使用预组合字符；无法完整预组合时保留 NFC 序列。" />
                <RadioButton x:Name="NfdOutputRadio"
                             Content="NFD"
                             GroupName="CompactOutputNormalization"
                             Style="{StaticResource CompactModeRadioStyle}"
                             Checked="OutputModeRadio_Checked"
                             AutomationProperties.Name="NFD 输出"
                             AutomationProperties.AutomationId="CompactNfdRadio"
                             ToolTip="NFD 输出：完全分解为基础字母与组合符号；此模式不应用例外规则。" />
            </StackPanel>

            <TextBlock Grid.Column="3"
                       Text="Backspace 删除最后一个符号"
                       FontSize="10"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </Grid>

        <!-- 符号围绕预览字母：上方一排、下方一排，其余位置放左右两列。
             不使用位置名称文字；名称只出现在悬停提示和辅助功能名称中。 -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Border Background="{StaticResource PreviewBrush}"
                    CornerRadius="10"
                    Padding="8,6"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel x:Name="AboveMarksPanel"
                               Grid.Row="0"
                               HorizontalAlignment="Center"
                               Orientation="Horizontal"
                               AutomationProperties.AutomationId="CompactAboveMarksPanel" />

                    <Grid Grid.Row="1" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="LeftMarksPanel"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    AutomationProperties.AutomationId="CompactLeftMarksPanel" />

                        <Border Grid.Column="1"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,2"
                                MinWidth="132"
                                MinHeight="76"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewTextBlock"
                                       Text="—"
                                       FontFamily="Cambria Math"
                                       FontSize="44"
                                       Foreground="{StaticResource InkBrush}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MinHeight="62"
                                       TextOptions.TextFormattingMode="Ideal"
                                       AutomationProperties.AutomationId="CompactPreviewTextBlock" />
                        </Border>

                        <StackPanel x:Name="RightMarksPanel"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    AutomationProperties.AutomationId="CompactRightMarksPanel" />
                    </Grid>

                    <WrapPanel x:Name="BelowMarksPanel"
                               Grid.Row="2"
                               HorizontalAlignment="Center"
                               Orientation="Horizontal"
                               AutomationProperties.AutomationId="CompactBelowMarksPanel" />
                </Grid>
            </Border>
        </ScrollViewer>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="4"
                   Margin="2,6,2,6"
                   FontSize="10"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   MinHeight="28"
                   MaxHeight="46"
                   Text="就绪"
                   AutomationProperties.AutomationId="CompactStatusTextBlock" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ActionHintTextBlock"
                       Text="Enter 插入 · Esc 取消"
                       FontSize="10"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Margin="0,0,8,0"
                       AutomationProperties.AutomationId="CompactActionHint" />

            <Button x:Name="CopyResultButton"
                    Grid.Column="1"
                    Content="复制结果"
                    Style="{StaticResource CompactSecondaryButtonStyle}"
                    Padding="8,5"
                    Click="CopyResultButton_Click"
                    IsEnabled="False"
                    ToolTip="只把结果写入剪贴板，不向其他应用发送粘贴。"
                    AutomationProperties.Name="复制结果"
                    AutomationProperties.AutomationId="CompactCopyButton" />

            <Button x:Name="InsertButton"
                    Grid.Column="2"
                    Content="插入（Enter）"
                    Style="{StaticResource CompactPrimaryButtonStyle}"
                    Click="InsertButton_Click"
                    IsEnabled="False"
                    Margin="8,0,0,0"
                    ToolTip="把结果写入剪贴板，发送 Ctrl+V 到打开紧凑窗口前的目标应用。"
                    AutomationProperties.Name="插入到目标应用"
                    AutomationProperties.AutomationId="CompactInsertButton" />

            <Button x:Name="CancelButton"
                    Grid.Column="3"
                    Content="取消（Esc）"
                    Style="{StaticResource CompactSecondaryButtonStyle}"
                    Click="CancelButton_Click"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="CompactCancelButton" />
        </Grid>
    </Grid>
</Window>
